    {
      "key": "at_database_outcome",
      "value": "Database functions correctly."
    },
    {
      "key": "ot_steps",
      "value": "Execute operational workflow end-to-end."
    },
    {
      "key": "ot_outcome",
      "value": "Solution operates successfully."
    },
    {
      "key": "ot_stig_testname",
      "value": "STIG Compliance Review"
    },
    {
      "key": "ot_stig_steps",
