{
    "$schema": "https://json-schema.org/draft-07/schema#",
    "$id": "https://raw.githubusercontent.com/alrosado/azure-rmf-accelerator-json/refs/heads/main/schema/v1/ara.schema.json",
    "title": "Azure RMF Accelerator schema",
    "version": "1.0.0",
    "description": "Canonical schema for Azure RMF Accelerator artifact generation.",
    "type": "object",
    "properties": {
        "system": {
            "type": "string",
            "description": "Name of the system being modeled."
        },
        "version": {
            "type": "string",
            "description": "Version of the system being modeled."
        },
        "customer": {
            "type": "string",
            "description": "Name of the customer for which this system is being modeled."
        },
        "roles": {
            "type": "array",
            "description": "List of roles that are defined for the system. These roles are used to define access to resources in the system.",
            "items": {
                "type": "object",
                "properties": {
                    "title": {
                        "type": "string",
                        "description": "Title of the role"
                    },
                    "key": {
                        "type": "string",
                        "description": "Key identifier of the role. This is used in other parts of the json file to link the role to specific access."
                    },
                    "group": {
                        "type": "string",
                        "description": "Name of the group that is primarily linked to this role."
                    },
                    "active": {
                        "type": "boolean",
                        "description": "Whether the role is currently active."
                    },
                    "description": {
                        "type": "string",
                        "description": "Description about what the purpose of the role is"
                    },
                    "members": {
                        "type": "array",
                        "description": "Initial members of the role. Not required; this is only in the case that a customer needs an explicit list of users defined early.",
                        "items": {
                            "type": "string"
                        }
                    }
                },
                "required": [
                    "title",
                    "key",
                    "group",
                    "active",
                    "description"
                ]
            }
        },
        "environments": {
            "type": "array",
            "description": "Environments contained within the system.",
            "items": {
                "type": "object",
                "properties": {
                    "key": {
                        "type": "string",
                        "description": "Key identifier of the environment. This is used in other parts of the json file to link resources to specific environments."
                    },
                    "resourcegroups": {
                        "type": "array",
                        "description": "Resource groups contained within the environment.",
                        "items": {
                            "type": "object",
                            "properties": {
                                "name": {
                                    "type": "string",
                                    "description": "Name of the resource group"
                                },
                                "roles": {
                                    "type": "array",
                                    "description": "Roles that have access to the resource group.",
                                    "items": {
                                        "type": "object",
                                        "properties": {
                                            "role": {
                                                "type": "string",
                                                "description": "Key identifier of the role that has access to the resource group."
                                            },
                                            "icamRole": {
                                                "type": "string",
                                                "description": "Name of the ICAM system role that is assigned to the role for access to the resource group."
                                            }
                                        },
                                        "required": [
                                            "role",
                                            "icamRole"
                                        ]
                                    }
                                },
                                "resources": {
                                    "type": "array",
                                    "description": "Resources contained within the resource group.",
                                    "items": {
                                        "type": "object",
                                        "properties": {
                                            "type": {
                                                "type": "string",
                                                "description": "Type of the resource."
                                            },
                                            "name": {
                                                "type": "string",
                                                "description": "Name of the resource."
                                            },
                                            "description": {
                                                "type": "string",
                                                "description": "Description of the resource."
                                            },
                                            "iacModule": {
                                                "type": "object",
                                                "description": "Infrastructure as Code module that is used to deploy the resource.",
                                                "properties": {
                                                    "name": {
                                                        "type": "string",
                                                        "description": "Name of the IaC module"
                                                    },
                                                    "path": {
                                                        "type": "string",
                                                        "description": "Path to the IaC module. This is relative to the root of the repository."
                                                    }
                                                }
                                            },
                                            "active": {
                                                "type": "boolean",
                                                "description": "Whether the resource is currently active."
                                            },
                                            "linkedResources": {
                                                "type": "array",
                                                "description": "Resources that are linked to this resource. This is used to model dependencies between resources. For simplicity, this should be a one way linked relationship. Example: If resource A is linked to resource B, then resource B should not be linked to resource A.",
                                                "items": {
                                                    "type": "object",
                                                    "properties": {
                                                        "type": {
                                                            "type": "string",
                                                            "description": "Type of the resource."
                                                        },
                                                        "name": {
                                                            "type": "string",
                                                            "description": "Name of the resource."
                                                        },
                                                        "description": {
                                                            "type": "string",
                                                            "description": "Description of the relationship to this resource. Examples: 'Child', 'Networking', 'Logging', 'Depends on', 'Uses', 'Is used by', etc."
                                                        },
                                                        "active": {
                                                            "type": "boolean",
                                                            "description": "Whether the link to this resource is currently active."
                                                        }
                                                    },
                                                    "required": [
                                                        "type",
                                                        "name",
                                                        "description",
                                                        "active"
                                                    ]
                                                }
                                            },
                                            "friendlyName": {
                                                "type": "string",
                                                "description": "Friendly name of the resource. This is used in documentation and other places where a more human-readable name is desired."
                                            },
                                            "roles": {
                                                "type": "array",
                                                "description": "Roles that have access to the resource.",
                                                "items": {
                                                    "type": "object",
                                                    "properties": {
                                                        "role": {
                                                            "type": "string",
                                                            "description": "Key identifier of the role that has access to the resource."
                                                        },
                                                        "icamRole": {
                                                            "type": "string",
                                                            "description": "Name of the ICAM system role that is assigned to the role for access to the resource."
                                                        }
                                                    },
                                                    "required": [
                                                        "role",
                                                        "icamRole"
                                                    ]
                                                }
                                            },
                                            "software": {
                                                "type": "array",
                                                "description": "Software that is used in the resource. This is used to track what software is being used in the resource and what version.",
                                                "items": {
                                                    "type": "object",
                                                    "properties": {
                                                        "name": {
                                                            "type": "string",
                                                            "description": "Name of the software"
                                                        },
                                                        "version": {
                                                            "type": "string",
                                                            "description": "Version of the software being used in this solution"
                                                        },
                                                        "description": {
                                                            "type": "string",
                                                            "description": "Description of the software being used in this solution"
                                                        }
                                                    },
                                                    "required": [
                                                        "name"
                                                    ]
                                                }
                                            }
                                        },
                                        "required": [
                                            "type",
                                            "name",
                                            "description",
                                            "active"
                                        ]
                                    }
                                }
                            },
                            "required": [
                                "name",
                                "roles",
                                "resources"
                            ]
                        }
                    }
                }
            }
        },
        "software": {
            "type": "array",
            "description": "List of software used in the system. This is used to track what software is being used in the system and what version.",
            "items": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "description": "Name of the software"
                    },
                    "version": {
                        "type": "string",
                        "description": "Version of the software being used in this solution"
                    },
                    "description": {
                        "type": "string",
                        "description": "Description of the software being used in this solution"
                    },
                    "type": {
                        "type": "string",
                        "description": "Type of software. Examples: Application, Library, etc."
                    }
                },
                "required": [
                    "name",
                    "version",
                    "description"
                ]
            }
        },
        "stigs": {
            "type": "array",
            "description": "STIGs that are applicable to this system.",
            "items": {
                "type": "object",
                "properties": {
                    "resourceType": {
                        "type": "string",
                        "description": "Resource type that this STIG applies to."
                    },
                    "stig": {
                        "type": "string",
                        "description": "Identifier for the STIG that is applicable within this system."
                    },
                    "applier": {
                        "type": "string",
                        "description": "Key identifier of the role that is responsible for applying this STIG."
                    }
                }
            }
        },
        "resourcetypes": {
            "type": "array",
            "description": "Friendly names of official resource type names",
            "items": {
                "type": "object",
                "properties": {
                    "key": {
                        "type": "string",
                        "description": "Official resource type name"
                    },
                    "friendlyName": {
                        "type": "string",
                        "description": "Friendly name of the resource type"
                    }
                }
            }
        },
        "strings": {
            "type": "array",
            "description": "Strings used in the system. This is used to track what strings are being used in the system and what version.",
            "items": {
                "type": "object",
                "properties": {
                    "key": {
                        "type": "string",
                        "description": "Key for the string"
                    },
                    "value": {
                        "type": "string",
                        "description": "Value of the string"
                    }
                }
            }
        }
    }
}